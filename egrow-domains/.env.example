# Αντίγραψε σε .env.local (τοπικά) και βάλε τα ίδια στο Vercel -> Settings -> Environment Variables.
# ΠΟΤΕ μην κάνεις commit πραγματικά κλειδιά.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Το κύριο site (για τους συνδέσμους επιστροφής)
NEXT_PUBLIC_MAIN_URL=https://egrowcreative.gr

# name.com API (https://www.name.com/account/settings/api)
# NAMECOM_ENV=prod  -> πραγματικές καταχωρήσεις/χρεώσεις. Οτιδήποτε άλλο -> sandbox (api.dev.name.com).
NAMECOM_ENV=dev
NAMECOM_USERNAME=
NAMECOM_TOKEN=

# PayPal (https://developer.paypal.com/dashboard/applications). Φτιάξε μια εφαρμογή και πάρε Client ID και Secret.
# PAYPAL_ENV=live -> πραγματικές πληρωμές. Οτιδήποτε άλλο -> sandbox (δοκιμές).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Μυστικό για την κρυπτογράφηση των στοιχείων πελάτη στο return URL. Βάλε μια τυχαία φράση 32+ χαρακτήρων.
APP_SECRET=

# Τιμολόγηση: κόστος name.com είναι σε USD
EUR_PER_USD=0.92
VAT_RATE=0.24

# Email ειδοποιήσεων μέσω Resend (προαιρετικό. Χωρίς αυτά γράφει μόνο στα logs)
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=Egrow Creative <onboarding@resend.dev>
